+        self.assertEqual((cfg["exe"], cfg["backend"], cfg["port"]), ("component:strata-engine", "sycl", 8080))
+        a = cfg["args"]
+        self.assertEqual(a[a.index("--pack") + 1], str(data / "packs" / "q2_0"))
